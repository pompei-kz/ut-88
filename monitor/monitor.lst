                    ;==============================================================================
                    ;  МОНИТОР ЮТ-88 (ПЗУ 0000H-03FFH), процессор КР580ВМ80А (Intel 8080)
                    ;  Дизассемблировано по фотографиям дампа monitor-1.png / monitor-2.png
                    ;
                    ;  Оборудование:
                    ;    9000H        - индикатор: 2 младших разряда (байт данных)
                    ;    9001H-9002H  - индикатор: 4 старших разряда (адрес, L,H)
                    ;    порт A0H     - клавиатура (0 = нет нажатия, 80H = клавиша "ШГ" (шаг назад))
                    ;    порт A1H     - магнитофон (бит 0 - вход/выход)
                    ;    C000H-C3FFH  - ОЗУ 1 Кб
                    ;    RST 7        - прерывание от таймера 1 Гц (часы)
                    ;
                    ;  Рабочие ячейки ОЗУ:
                    ;    C3EEH        - вершина стека (SP), там же параметр директивы замены адресов
                    ;    C3F0H..C3FAH - параметры служебных подпрограмм перемещения/коррекции
                    ;    C3FCH        - признак полярности сигнала магнитофона (00/FF)
                    ;    C3FDH        - часы: секунды (BCD)
                    ;    C3FEH        - часы: минуты  (BCD)
                    ;    C3FFH        - часы: часы    (BCD)
                    ;
                    ;  Директивы (цифра с клавиатуры после индикации "11"):
                    ;    0 - ввод (запись) в память с адреса      8 - контрольная сумма блока
                    ;    1 - ввод в память с адреса C000H         9 - запись на магнитофон
                    ;    2 - просмотр памяти с адреса C000H       A - чтение с магнитофона
                    ;    3 - тест индикатора                      B - индикация часов
                    ;    4 - тест ОЗУ C000H-C3FFH                 C - ввод в память (с запретом
                    ;    5 - просмотр памяти с адреса                 прерываний, часы стоят)
                    ;    6 - запуск программы с адреса C000H
                    ;    7 - запуск программы с адреса
                    ;
                    ;  Дополнительные подпрограммы (запуск директивой 7 по адресу):
                    ;    0200H - перемещение блока памяти
                    ;    025FH - перемещение блока с коррекцией адресов
                    ;    02E5H - коррекция адресов в блоке (под будущий адрес размещения)
                    ;    0309H - замена адреса в 3-байтовых командах блока
                    ;    035EH - вставка байта
                    ;    0388H - удаление байта
                    ;    03B2H - сравнение двух блоков памяти
                    ;    03DDH - вывод на индикатор содержимого регистров (CALL 03DDH из программы)
                    ;==============================================================================
                    
     =9000          DISP_D      EQU     9000H           ; индикатор данных
     =9001          DISP_A      EQU     9001H           ; индикатор адреса
     =00A0          KBD         EQU     0A0H            ; порт клавиатуры
     =00A1          TAPE        EQU     0A1H            ; порт магнитофона
     =C000          RAM         EQU     0C000H          ; начало ОЗУ
     =C3EE          STACK       EQU     0C3EEH          ; вершина стека
                    
     =C3F0          V_START     EQU     0C3F0H          ; начальный адрес исходного блока
     =C3F2          V_END       EQU     0C3F2H          ; конечный адрес исходного блока
     =C3F4          V_NSTART    EQU     0C3F4H          ; начальный адрес обрабатываемого блока
     =C3F6          V_NEND      EQU     0C3F6H          ; конечный адрес обрабатываемого блока
     =C3F8          V_OFFS      EQU     0C3F8H          ; смещение (новый адрес - старый)
     =C3FA          V_ADDR      EQU     0C3FAH          ; новый адрес / заменяемый адрес
     =C3EE          V_ADDR2     EQU     0C3EEH          ; адрес-замена (директива 0309H)
     =C3FC          TPOL        EQU     0C3FCH          ; полярность магнитофона
     =C3FD          CLK_S       EQU     0C3FDH          ; секунды
     =C3FE          CLK_M       EQU     0C3FEH          ; минуты
     =C3FF          CLK_H       EQU     0C3FFH          ; часы
                    
                                ORG     0000H
                    
                    ;------------------------------------------------------------------------------
                    ; RST 0 - холодный/горячий старт монитора
                    ;------------------------------------------------------------------------------
0000  31 EE C3      START:      LXI     SP,STACK
0003  3E 11                     MVI     A,11H           ; приглашение "11" на индикаторе
0005  C3 3B 00                  JMP     MONITOR
                    
                    ;------------------------------------------------------------------------------
                    ; RST 1 - вывод байта A на магнитофон
                    ;------------------------------------------------------------------------------
0008  C3 00 01      RST1:       JMP     TAPEOUT
                    
                    ; директива 5: просмотр памяти с введённого адреса
000B  F7            DIR5:       RST     6               ; ввод адреса в DE
000C  EB                        XCHG
000D  C3 7D 00                  JMP     VIEW
                    
                    ;------------------------------------------------------------------------------
                    ; RST 2 - ввод байта с клавиатуры (две 16-ричные цифры) в A,
                    ;         с отображением на индикаторе данных
                    ;------------------------------------------------------------------------------
0010  D5            RST2:       PUSH    D
0011  AF                        XRA     A
0012  57                        MOV     D,A
0013  E7                        RST     4               ; первая цифра (старшая тетрада)
0014  07                        RLC
0015  C3 47 00                  JMP     INBYTE2
                    
                    ;------------------------------------------------------------------------------
                    ; RST 3 - пауза (~0.25-0.5 с), защита от дребезга / автоповтора клавиш
                    ;------------------------------------------------------------------------------
0018  E5            RST3:       PUSH    H
0019  F5                        PUSH    PSW
001A  21 50 66                  LXI     H,6650H
001D  C3 56 00                  JMP     DELAY
                    
                    ;------------------------------------------------------------------------------
                    ; RST 4 - ожидание нажатия клавиши, код 0..F в A
                    ;------------------------------------------------------------------------------
0020  DF            RST4:       RST     3
0021  C3 5F 00                  JMP     GETKEY
0024  00                        DB      00H
                    
                    ; директива 6: запуск программы с адреса C000H
0025  C3 00 C0      DIR6:       JMP     RAM
                    
                    ;------------------------------------------------------------------------------
                    ; RST 5 - вывод на индикатор: A - в разряды данных, HL - в разряды адреса
                    ;------------------------------------------------------------------------------
0028  32 00 90      RST5:       STA     DISP_D
002B  22 01 90                  SHLD    DISP_A
002E  C9                        RET
002F  00                        DB      00H
                    
                    ;------------------------------------------------------------------------------
                    ; RST 6 - ввод 16-битного адреса с клавиатуры в DE (D - старший байт)
                    ;------------------------------------------------------------------------------
0030  F5            RST6:       PUSH    PSW
0031  D7                        RST     2
0032  57                        MOV     D,A
0033  D7                        RST     2
0034  5F                        MOV     E,A
0035  F1                        POP     PSW
0036  C9                        RET
0037  00                        DB      00H
                    
                    ;------------------------------------------------------------------------------
                    ; RST 7 - прерывание от таймера (часы)
                    ;------------------------------------------------------------------------------
0038  C3 C1 00      RST7:       JMP     CLOCK
                    
                    ;------------------------------------------------------------------------------
                    ; Основной цикл монитора: показать A, принять номер директивы, перейти
                    ;------------------------------------------------------------------------------
003B  FB            MONITOR:    EI
003C  32 00 90                  STA     DISP_D
003F  E7                        RST     4               ; номер директивы 0..F
0040  C6 F3                     ADI     DIRTAB          ; A = младший байт адреса в таблице
0042  26 00                     MVI     H,00H
0044  6F                        MOV     L,A
0045  6E                        MOV     L,M             ; L = младший байт адреса обработчика
0046  E9                        PCHL                    ; все обработчики - в 0000H..00FFH
                    
                    ; продолжение RST 2: вторая цифра
0047  07            INBYTE2:    RLC
0048  07                        RLC
0049  07                        RLC                     ; A = цифра * 16
004A  B2                        ORA     D
004B  57                        MOV     D,A
004C  32 00 90                  STA     DISP_D
004F  E7                        RST     4               ; вторая цифра (младшая тетрада)
0050  B2                        ORA     D
0051  32 00 90                  STA     DISP_D
0054  D1                        POP     D
0055  C9                        RET
                    
                    ; продолжение RST 3: цикл задержки
0056  2B            DELAY:      DCX     H
0057  7D                        MOV     A,L
0058  B4                        ORA     H
0059  C2 56 00                  JNZ     DELAY
005C  F1                        POP     PSW
005D  E1                        POP     H
005E  C9                        RET
                    
                    ; продолжение RST 4: опрос клавиатуры
005F  DB A0         GETKEY:     IN      KBD
0061  C6 00                     ADI     00H             ; установить флаги
0063  CA 5F 00                  JZ      GETKEY          ; клавиша не нажата - ждать
0066  FE 80                     CPI     80H
0068  CA 6E 00                  JZ      KEYBACK         ; клавиша "ШГ" - шаг назад
006B  E6 0F                     ANI     0FH
006D  C9                        RET
                    
                    ; клавиша "ШГ": вернуться на предыдущий адрес и перейти в режим ввода
                    ; (ИСПРАВЛЕНО: в оригинальном дампе здесь DCX SP / DCX SP (3B 3B),
                    ;  заменено на INX SP / INX SP (33 33) - снять адрес возврата из стека)
006E  2B            KEYBACK:    DCX     H
006F  33                        INX     SP
0070  33                        INX     SP
                    
                    ;------------------------------------------------------------------------------
                    ; Ввод в память с адреса HL (бесконечный цикл, выход - RESET)
                    ;------------------------------------------------------------------------------
0071  AF            WRMEM:      XRA     A
0072  EF                        RST     5               ; показать адрес HL и 00
0073  D7                        RST     2               ; ввести байт
0074  77                        MOV     M,A             ; записать в память
0075  DF                        RST     3
0076  23                        INX     H
0077  C3 71 00                  JMP     WRMEM
                    
                    ; директива 2: просмотр памяти с адреса C000H
007A  21 00 C0      DIR2:       LXI     H,RAM
                    
                    ; просмотр памяти с адреса HL: каждая клавиша - следующий адрес
007D  E7            VIEW:       RST     4
007E  7E                        MOV     A,M
007F  EF                        RST     5
0080  23                        INX     H
0081  C3 7D 00                  JMP     VIEW
                    
                    ; директива 7: запуск программы с введённого адреса
0084  F7            DIR7:       RST     6
0085  EB                        XCHG
0086  AF                        XRA     A
0087  EF                        RST     5
0088  DF                        RST     3
0089  E9                        PCHL
                    
                    ; директива 1: ввод в память с адреса C000H
008A  21 00 C0      DIR1:       LXI     H,RAM
008D  C3 71 00                  JMP     WRMEM
                    
                    ; директива C: ввод в память с запретом прерываний
0090  F3            DIRC:       DI
                    ; директива 0: ввод в память с введённого адреса
0091  F7            DIR0:       RST     6
0092  EB                        XCHG
0093  C3 71 00                  JMP     WRMEM
                    
                    ;------------------------------------------------------------------------------
                    ; Директива 3: тест индикатора - на всех разрядах 00,11,22,...,FF
                    ;------------------------------------------------------------------------------
0096  AF            DIR3:       XRA     A
0097  67            DIR3L:      MOV     H,A
0098  6F                        MOV     L,A
0099  EF                        RST     5
009A  DF                        RST     3
009B  C6 11                     ADI     11H
009D  FE 10                     CPI     10H             ; после FF+11 = 10 - конец
009F  C2 97 00                  JNZ     DIR3L
00A2  C7                        RST     0
                    
                    ;------------------------------------------------------------------------------
                    ; Директива 4: тест ОЗУ C000H-C3FFH (запись 00 и FF с проверкой).
                    ; При ошибке показывает адрес и прочитанный байт, клавиша - продолжить
                    ;------------------------------------------------------------------------------
00A3  21 00 C0      DIR4:       LXI     H,RAM
00A6  AF            MTEST:      XRA     A
00A7  77                        MOV     M,A
00A8  7E                        MOV     A,M
00A9  B7                        ORA     A
00AA  C2 BB 00                  JNZ     MTERR           ; не записался 00
00AD  3D                        DCR     A
00AE  77                        MOV     M,A
00AF  7E                        MOV     A,M
00B0  3C                        INR     A
00B1  C2 BB 00                  JNZ     MTERR           ; не записался FF
00B4  23                        INX     H
00B5  7C                        MOV     A,H
00B6  E6 04                     ANI     04H             ; дошли до C400H?
00B8  CA A6 00                  JZ      MTEST
00BB  7E            MTERR:      MOV     A,M
00BC  EF                        RST     5
00BD  E7                        RST     4
00BE  C3 A6 00                  JMP     MTEST
                    
                    ;------------------------------------------------------------------------------
                    ; Обработчик прерывания таймера: секунды/минуты/часы в BCD
                    ;------------------------------------------------------------------------------
00C1  F3            CLOCK:      DI
00C2  F5                        PUSH    PSW
00C3  C5                        PUSH    B
00C4  D5                        PUSH    D
00C5  E5                        PUSH    H
00C6  21 E4 00                  LXI     H,CLKLIM
00C9  11 FD C3                  LXI     D,CLK_S
00CC  06 03                     MVI     B,03H
00CE  1A            CLKL:       LDAX    D
00CF  3C                        INR     A
00D0  27                        DAA
00D1  12                        STAX    D
00D2  BE                        CMP     M               ; достигнут предел?
00D3  C2 DE 00                  JNZ     CLKX
00D6  AF                        XRA     A               ; обнулить и перенести в старший
00D7  12                        STAX    D
00D8  23                        INX     H
00D9  13                        INX     D
00DA  05                        DCR     B
00DB  C2 CE 00                  JNZ     CLKL
00DE  E1            CLKX:       POP     H
00DF  D1                        POP     D
00E0  C1                        POP     B
00E1  F1                        POP     PSW
00E2  FB                        EI
00E3  C9                        RET
                    
00E4  60 60 24      CLKLIM:     DB      60H,60H,24H     ; пределы: секунды, минуты, часы
                    
00E7  C3 9A 01      DIR9:       JMP     TWRITE          ; директива 9: запись на магнитофон
00EA  C3 C2 01      DIRA:       JMP     TREAD           ; директива A: чтение с магнитофона
00ED  C3 75 01      DIR8:       JMP     CHKSUM          ; директива 8: контрольная сумма
00F0  C3 F5 01      DIRB:       JMP     SHOWCLK         ; директива B: индикация часов
                    
                    ; Таблица директив: младшие байты адресов обработчиков (страница 00xxH)
00F3  91            DIRTAB:     DB      DIR0            ; 0 - 91H
00F4  8A                        DB      DIR1            ; 1 - 8AH
00F5  7A                        DB      DIR2            ; 2 - 7AH
00F6  96                        DB      DIR3            ; 3 - 96H
00F7  A3                        DB      DIR4            ; 4 - A3H
00F8  0B                        DB      DIR5            ; 5 - 0BH
00F9  25                        DB      DIR6            ; 6 - 25H
00FA  84                        DB      DIR7            ; 7 - 84H
00FB  ED                        DB      DIR8            ; 8 - EDH
00FC  E7                        DB      DIR9            ; 9 - E7H
00FD  EA                        DB      DIRA            ; A - EAH
00FE  F0                        DB      DIRB            ; B - F0H
00FF  90                        DB      DIRC            ; C - 90H
                    
                    ;------------------------------------------------------------------------------
                    ; Вывод байта A на магнитофон (фазовое кодирование, старшим битом вперёд)
                    ;------------------------------------------------------------------------------
0100  C5            TAPEOUT:    PUSH    B
0101  D5                        PUSH    D
0102  F5                        PUSH    PSW
0103  57                        MOV     D,A
0104  0E 08                     MVI     C,08H
0106  7A            TOUTL:      MOV     A,D
0107  07                        RLC
0108  57                        MOV     D,A
0109  3E 01                     MVI     A,01H
010B  AA                        XRA     D
010C  D3 A1                     OUT     TAPE            ; первая половина бита - инверсия
010E  CD 21 01                  CALL    TDELAY
0111  3E 00                     MVI     A,00H
0113  AA                        XRA     D
0114  D3 A1                     OUT     TAPE            ; вторая половина бита - прямой
0116  CD 21 01                  CALL    TDELAY
0119  0D                        DCR     C
011A  C2 06 01                  JNZ     TOUTL
011D  F1                        POP     PSW
011E  D1                        POP     D
011F  C1                        POP     B
0120  C9                        RET
                    
0121  06 1E         TDELAY:     MVI     B,1EH           ; задержка полупериода записи
0123  05            TDL:        DCR     B
0124  C2 23 01                  JNZ     TDL
0127  C9                        RET
                    
                    ;------------------------------------------------------------------------------
                    ; Ввод байта с магнитофона.
                    ;   A = FFH - с поиском синхробайта E6H (определяется и полярность),
                    ;   A = 08H - чтение очередного байта без поиска.
                    ;   Результат в A.
                    ;------------------------------------------------------------------------------
0128  C5            TAPEIN:     PUSH    B
0129  D5                        PUSH    D
012A  0E 00                     MVI     C,00H
012C  57                        MOV     D,A
012D  DB A1                     IN      TAPE
012F  5F                        MOV     E,A
0130  79            TINL:       MOV     A,C
0131  E6 7F                     ANI     7FH
0133  07                        RLC
0134  4F                        MOV     C,A
0135  DB A1         TINW:       IN      TAPE
0137  BB                        CMP     E
0138  CA 35 01                  JZ      TINW            ; ждать перепада
013B  E6 01                     ANI     01H
013D  B1                        ORA     C
013E  4F                        MOV     C,A
013F  CD 6E 01                  CALL    TIDELAY
0142  DB A1                     IN      TAPE
0144  5F                        MOV     E,A
0145  7A                        MOV     A,D
0146  B7                        ORA     A
0147  F2 63 01                  JP      TINCNT          ; поиск синхробайта не нужен
014A  79                        MOV     A,C
014B  FE E6                     CPI     0E6H
014D  C2 57 01                  JNZ     TIN19
0150  AF                        XRA     A               ; прямая полярность
0151  32 FC C3                  STA     TPOL
0154  C3 61 01                  JMP     TINSYN
0157  FE 19         TIN19:      CPI     19H             ; E6H инвертированный
0159  C2 30 01                  JNZ     TINL
015C  3E FF                     MVI     A,0FFH          ; обратная полярность
015E  32 FC C3                  STA     TPOL
0161  16 09         TINSYN:     MVI     D,09H
0163  15            TINCNT:     DCR     D
0164  C2 30 01                  JNZ     TINL
0167  3A FC C3                  LDA     TPOL
016A  A9                        XRA     C               ; учесть полярность
016B  D1                        POP     D
016C  C1                        POP     B
016D  C9                        RET
                    
016E  06 2D         TIDELAY:    MVI     B,2DH           ; задержка 3/4 периода при чтении
0170  05            TIDL:       DCR     B
0171  C2 70 01                  JNZ     TIDL
0174  C9                        RET
                    
                    ;------------------------------------------------------------------------------
                    ; Директива 8: контрольная сумма блока (ввод: начало, конец).
                    ; Сумма (16 бит) - на индикаторе адреса.
                    ;------------------------------------------------------------------------------
0175  C5            CHKSUM:     PUSH    B
0176  D5                        PUSH    D
0177  E5                        PUSH    H
0178  F5                        PUSH    PSW
0179  F7                        RST     6
017A  42                        MOV     B,D
017B  4B                        MOV     C,E             ; BC = начало
017C  F7                        RST     6               ; DE = конец
017D  2E 00         CHKSUM1:    MVI     L,00H
017F  65                        MOV     H,L
0180  0A            CHKL:       LDAX    B
0181  D5                        PUSH    D
0182  5F                        MOV     E,A
0183  16 00                     MVI     D,00H
0185  19                        DAD     D
0186  D1                        POP     D
0187  CD 94 01                  CALL    CMPBD
018A  03                        INX     B
018B  C2 80 01                  JNZ     CHKL
018E  EF                        RST     5
018F  F1                        POP     PSW
0190  E1                        POP     H
0191  D1                        POP     D
0192  C1                        POP     B
0193  C7                        RST     0
                    
                    ; сравнение DE и BC (Z=1 если равны)
0194  7A            CMPBD:      MOV     A,D
0195  B8                        CMP     B
0196  C0                        RNZ
0197  7B                        MOV     A,E
0198  B9                        CMP     C
0199  C9                        RET
                    
                    ;------------------------------------------------------------------------------
                    ; Директива 9: запись блока на магнитофон (ввод: начало, конец).
                    ; Формат: 256 x 00H, E6H, начало(H,L), конец(H,L), данные.
                    ; После записи показывает контрольную сумму.
                    ;------------------------------------------------------------------------------
019A  C5            TWRITE:     PUSH    B
019B  D5                        PUSH    D
019C  E5                        PUSH    H
019D  F5                        PUSH    PSW
019E  F7                        RST     6
019F  42                        MOV     B,D
01A0  4B                        MOV     C,E             ; BC = начало
01A1  F7                        RST     6               ; DE = конец
01A2  C5                        PUSH    B
01A3  AF                        XRA     A
01A4  6F                        MOV     L,A
01A5  CF            TWPIL:      RST     1               ; пилот-тон: 256 нулей
01A6  2C                        INR     L
01A7  C2 A5 01                  JNZ     TWPIL
01AA  3E E6                     MVI     A,0E6H          ; синхробайт
01AC  CF                        RST     1
01AD  78                        MOV     A,B
01AE  CF                        RST     1
01AF  79                        MOV     A,C
01B0  CF                        RST     1
01B1  7A                        MOV     A,D
01B2  CF                        RST     1
01B3  7B                        MOV     A,E
01B4  CF                        RST     1
01B5  0A            TWDAT:      LDAX    B
01B6  CF                        RST     1
01B7  CD 94 01                  CALL    CMPBD
01BA  03                        INX     B
01BB  C2 B5 01                  JNZ     TWDAT
01BE  C1                        POP     B
01BF  C3 7D 01                  JMP     CHKSUM1
                    
                    ;------------------------------------------------------------------------------
                    ; Директива A: чтение блока с магнитофона (ввод: смещение адреса загрузки).
                    ; После чтения показывает контрольную сумму.
                    ;------------------------------------------------------------------------------
01C2  C5            TREAD:      PUSH    B
01C3  D5                        PUSH    D
01C4  E5                        PUSH    H
01C5  F5                        PUSH    PSW
01C6  F7                        RST     6               ; DE = смещение
01C7  3E FF                     MVI     A,0FFH          ; поиск синхробайта
01C9  CD 28 01                  CALL    TAPEIN
01CC  67                        MOV     H,A
01CD  CD EE 01                  CALL    TIN8
01D0  6F                        MOV     L,A
01D1  19                        DAD     D
01D2  44                        MOV     B,H
01D3  4D                        MOV     C,L             ; BC = начало + смещение
01D4  C5                        PUSH    B
01D5  CD EE 01                  CALL    TIN8
01D8  67                        MOV     H,A
01D9  CD EE 01                  CALL    TIN8
01DC  6F                        MOV     L,A
01DD  19                        DAD     D
01DE  EB                        XCHG                    ; DE = конец + смещение
01DF  CD EE 01      TRDAT:      CALL    TIN8
01E2  02                        STAX    B
01E3  CD 94 01                  CALL    CMPBD
01E6  03                        INX     B
01E7  C2 DF 01                  JNZ     TRDAT
01EA  C1                        POP     B
01EB  C3 7D 01                  JMP     CHKSUM1
                    
01EE  3E 08         TIN8:       MVI     A,08H           ; чтение байта без поиска синхро
01F0  CD 28 01                  CALL    TAPEIN
01F3  C9                        RET
01F4  00                        DB      00H
                    
                    ;------------------------------------------------------------------------------
                    ; Директива B: индикация часов (ЧЧ ММ СС), выход - RESET
                    ;------------------------------------------------------------------------------
01F5  2A FE C3      SHOWCLK:    LHLD    CLK_M           ; L = минуты, H = часы
01F8  3A FD C3                  LDA     CLK_S
01FB  EF                        RST     5
01FC  DF                        RST     3
01FD  C3 F5 01                  JMP     SHOWCLK
                    
                    ;------------------------------------------------------------------------------
                    ; 0200H: перемещение блока памяти (ввод: начало, конец, адрес назначения).
                    ; Корректно при перекрытии областей.
                    ;------------------------------------------------------------------------------
0200  CD 24 02      MOVE:       CALL    MVPARM
0203  DA 0A 02                  JC      MOVEUP
0206  CD 0E 02                  CALL    COPYDN          ; назначение выше - копируем с конца
0209  C7                        RST     0
020A  CD 19 02      MOVEUP:     CALL    COPYUP          ; назначение ниже - копируем с начала
020D  C7                        RST     0
                    
                    ; копирование (DE)->(HL) с уменьшением адресов, пока DE <> BC (включительно)
020E  1A            COPYDN:     LDAX    D
020F  77                        MOV     M,A
0210  CD 94 01                  CALL    CMPBD
0213  1B                        DCX     D
0214  2B                        DCX     H
0215  C2 0E 02                  JNZ     COPYDN
0218  C9                        RET
                    
                    ; копирование (BC)->(HL) с увеличением адресов, пока BC <> DE (включительно)
0219  0A            COPYUP:     LDAX    B
021A  77                        MOV     M,A
021B  CD 94 01                  CALL    CMPBD
021E  03                        INX     B
021F  23                        INX     H
0220  C2 19 02                  JNZ     COPYUP
0223  C9                        RET
                    
                    ; ввод параметров перемещения и подготовка регистров:
                    ;   V_START, V_END - исходный блок, V_NSTART, V_NEND - новый блок,
                    ;   V_OFFS - смещение; BC = начало, DE = конец;
                    ;   CY=1: HL = новое начало (назначение ниже исходного),
                    ;   CY=0: HL = новый конец
0224  F7            MVPARM:     RST     6
0225  D5                        PUSH    D
0226  F7                        RST     6
0227  EB                        XCHG
0228  22 F2 C3                  SHLD    V_END
022B  E1                        POP     H
022C  22 F0 C3                  SHLD    V_START
022F  F7                        RST     6
0230  EB                        XCHG
0231  22 F4 C3                  SHLD    V_NSTART
0234  7D                        MOV     A,L
0235  93                        SUB     E
0236  6F                        MOV     L,A
0237  7C                        MOV     A,H
0238  9A                        SBB     D
0239  67                        MOV     H,A
023A  22 F8 C3                  SHLD    V_OFFS          ; смещение = назначение - начало
023D  4D                        MOV     C,L
023E  44                        MOV     B,H
023F  2A F2 C3                  LHLD    V_END
0242  E5                        PUSH    H
0243  09                        DAD     B
0244  22 F6 C3                  SHLD    V_NEND          ; новый конец = конец + смещение
0247  2A F0 C3                  LHLD    V_START
024A  4D                        MOV     C,L
024B  44                        MOV     B,H
024C  D1                        POP     D
024D  2A F4 C3                  LHLD    V_NSTART
0250  7D                        MOV     A,L
0251  91                        SUB     C
0252  7C                        MOV     A,H
0253  98                        SBB     B
0254  D8                        RC
0255  2A F6 C3                  LHLD    V_NEND
0258  C9                        RET
                    
                    ; сравнение HL и DE (Z=1 если равны)
0259  7C            CMPHD:      MOV     A,H
025A  BA                        CMP     D
025B  C0                        RNZ
025C  7D                        MOV     A,L
025D  BB                        CMP     E
025E  C9                        RET
                    
                    ;------------------------------------------------------------------------------
                    ; 025FH: перемещение блока с коррекцией адресов
                    ;------------------------------------------------------------------------------
025F  CD 24 02      MOVEREL:    CALL    MVPARM
0262  CD 66 02                  CALL    RELOC
0265  C7                        RST     0
                    
                    ;------------------------------------------------------------------------------
                    ; Коррекция адресов в блоке V_NSTART..V_NEND: в 3-байтовых командах
                    ; операнд, попадающий в V_START..V_END, увеличивается на V_OFFS.
                    ;------------------------------------------------------------------------------
0266  2A F4 C3      RELOC:      LHLD    V_NSTART
0269  56            RELL:       MOV     D,M             ; D = код команды
026A  E5                        PUSH    H
026B  CD B9 02                  CALL    CMDLEN          ; B = длина команды
026E  60                        MOV     H,B
026F  E3                        XTHL                    ; в стек - длина, HL - адрес команды
0270  78                        MOV     A,B
0271  FE 03                     CPI     03H
0273  C2 A5 02                  JNZ     RELSKIP
0276  23                        INX     H
0277  4E                        MOV     C,M
0278  23                        INX     H
0279  46                        MOV     B,M             ; BC = операнд
027A  2B                        DCX     H
027B  E5                        PUSH    H
027C  2A F0 C3                  LHLD    V_START
027F  79                        MOV     A,C
0280  95                        SUB     L
0281  78                        MOV     A,B
0282  9C                        SBB     H
0283  DA A3 02                  JC      RELNO           ; операнд < начала
0286  2A F2 C3                  LHLD    V_END
0289  7D                        MOV     A,L
028A  91                        SUB     C
028B  7C                        MOV     A,H
028C  98                        SBB     B
028D  DA A3 02                  JC      RELNO           ; операнд > конца
0290  2A F8 C3                  LHLD    V_OFFS
0293  7D                        MOV     A,L
0294  81                        ADD     C
0295  5F                        MOV     E,A
0296  7C                        MOV     A,H
0297  88                        ADC     B
0298  57                        MOV     D,A             ; DE = операнд + смещение
0299  E1                        POP     H
029A  73                        MOV     M,E
029B  23                        INX     H
029C  72                        MOV     M,D
029D  23                        INX     H               ; HL - на следующую команду
029E  33                        INX     SP
029F  33                        INX     SP              ; убрать длину из стека
02A0  C3 AB 02                  JMP     RELNXT
02A3  E1            RELNO:      POP     H
02A4  2B                        DCX     H
02A5  C1            RELSKIP:    POP     B               ; B = длина
02A6  23            RELADV:     INX     H
02A7  05                        DCR     B
02A8  C2 A6 02                  JNZ     RELADV
02AB  5D            RELNXT:     MOV     E,L
02AC  54                        MOV     D,H
02AD  2A F6 C3                  LHLD    V_NEND
02B0  23                        INX     H
02B1  CD 59 02                  CALL    CMPHD           ; дошли до конца блока?
02B4  EB                        XCHG
02B5  C2 69 02                  JNZ     RELL
02B8  C9                        RET
                    
                    ;------------------------------------------------------------------------------
                    ; Определение длины команды по коду в D. Результат: B = 1, 2 или 3.
                    ;------------------------------------------------------------------------------
02B9  01 06 03      CMDLEN:     LXI     B,0306H         ; B = 3 (длина), C = 6 (пар в группе)
02BC  21 D3 02                  LXI     H,LENTAB
02BF  7A            CLL:        MOV     A,D
02C0  A6                        ANA     M               ; маска
02C1  23                        INX     H
02C2  BE                        CMP     M               ; образец
02C3  C8                        RZ
02C4  23                        INX     H
02C5  0D                        DCR     C
02C6  C2 BF 02                  JNZ     CLL
02C9  0E 03                     MVI     C,03H           ; 3 пары для 2-байтовых команд
02CB  05                        DCR     B
02CC  78                        MOV     A,B
02CD  FE 01                     CPI     01H
02CF  C2 BF 02                  JNZ     CLL
02D2  C9                        RET
                    
                    ; таблица (маска, образец)
02D3  FF CD         LENTAB:     DB      0FFH,0CDH       ; CALL
02D5  C7 C4                     DB      0C7H,0C4H       ; Cxx
02D7  FF C3                     DB      0FFH,0C3H       ; JMP
02D9  C7 C2                     DB      0C7H,0C2H       ; Jxx
02DB  E7 22                     DB      0E7H,022H       ; SHLD/LHLD/STA/LDA
02DD  CF 01                     DB      0CFH,001H       ; LXI
02DF  C7 06                     DB      0C7H,006H       ; MVI
02E1  C7 C6                     DB      0C7H,0C6H       ; ADI..CPI
02E3  F7 D3                     DB      0F7H,0D3H       ; OUT/IN
                    
                    ;------------------------------------------------------------------------------
                    ; 02E5H: коррекция адресов в блоке на месте под будущий адрес
                    ;        (ввод: начало, конец, адрес будущего размещения)
                    ;------------------------------------------------------------------------------
02E5  F7            ADJUST:     RST     6
02E6  EB                        XCHG
02E7  22 F0 C3                  SHLD    V_START
02EA  22 F4 C3                  SHLD    V_NSTART
02ED  E5                        PUSH    H
02EE  F7                        RST     6
02EF  EB                        XCHG
02F0  22 F2 C3                  SHLD    V_END
02F3  22 F6 C3                  SHLD    V_NEND
02F6  F7                        RST     6
02F7  EB                        XCHG
02F8  22 FA C3                  SHLD    V_ADDR
02FB  D1                        POP     D
02FC  7D                        MOV     A,L
02FD  93                        SUB     E
02FE  6F                        MOV     L,A
02FF  7C                        MOV     A,H
0300  9A                        SBB     D
0301  67                        MOV     H,A
0302  22 F8 C3                  SHLD    V_OFFS
0305  CD 66 02                  CALL    RELOC
0308  C7                        RST     0
                    
                    ;------------------------------------------------------------------------------
                    ; 0309H: замена адреса в 3-байтовых командах блока
                    ;        (ввод: начало, конец, старый адрес, новый адрес)
                    ;------------------------------------------------------------------------------
0309  F7            REPADR:     RST     6
030A  D5                        PUSH    D
030B  F7                        RST     6
030C  EB                        XCHG
030D  22 F2 C3                  SHLD    V_END
0310  F7                        RST     6
0311  EB                        XCHG
0312  22 FA C3                  SHLD    V_ADDR          ; что искать
0315  F7                        RST     6
0316  EB                        XCHG
0317  22 EE C3                  SHLD    V_ADDR2         ; на что заменить
031A  E1                        POP     H
031B  22 F0 C3                  SHLD    V_START
031E  56            RPL:        MOV     D,M
031F  E5                        PUSH    H
0320  CD B9 02                  CALL    CMDLEN
0323  60                        MOV     H,B
0324  E3                        XTHL
0325  78                        MOV     A,B
0326  FE 03                     CPI     03H
0328  C2 4A 03                  JNZ     RPSKIP
032B  23                        INX     H
032C  5E                        MOV     E,M
032D  23                        INX     H
032E  56                        MOV     D,M             ; DE = операнд
032F  2B                        DCX     H
0330  E5                        PUSH    H
0331  2A FA C3                  LHLD    V_ADDR
0334  CD 59 02                  CALL    CMPHD
0337  C2 48 03                  JNZ     RPNO
033A  2A EE C3                  LHLD    V_ADDR2
033D  EB                        XCHG
033E  E1                        POP     H
033F  73                        MOV     M,E
0340  23                        INX     H
0341  72                        MOV     M,D
0342  23                        INX     H
0343  33                        INX     SP
0344  33                        INX     SP
0345  C3 50 03                  JMP     RPNXT
0348  E1            RPNO:       POP     H
0349  2B                        DCX     H
034A  C1            RPSKIP:     POP     B
034B  23            RPADV:      INX     H
034C  05                        DCR     B
034D  C2 4B 03                  JNZ     RPADV
0350  5D            RPNXT:      MOV     E,L
0351  54                        MOV     D,H
0352  2A F2 C3                  LHLD    V_END
0355  23                        INX     H
0356  CD 59 02                  CALL    CMPHD
0359  EB                        XCHG
035A  C2 1E 03                  JNZ     RPL
035D  C7                        RST     0
                    
                    ;------------------------------------------------------------------------------
                    ; 035EH: вставка байта (ввод: адрес вставки, конец программы, затем байт).
                    ; Блок сдвигается на 1 вверх, адреса корректируются.
                    ;------------------------------------------------------------------------------
035E  F7            INSBYTE:    RST     6
035F  EB                        XCHG
0360  22 F0 C3                  SHLD    V_START
0363  4D                        MOV     C,L
0364  44                        MOV     B,H             ; BC = адрес вставки
0365  F7                        RST     6
0366  6B                        MOV     L,E
0367  62                        MOV     H,D
0368  22 F2 C3                  SHLD    V_END
036B  23                        INX     H
036C  22 F6 C3                  SHLD    V_NEND
036F  CD 0E 02                  CALL    COPYDN          ; сдвиг блока вверх на 1
0372  AF                        XRA     A
0373  77                        MOV     M,A
0374  E5                        PUSH    H
0375  23                        INX     H
0376  22 F4 C3                  SHLD    V_NSTART
0379  21 01 00                  LXI     H,0001H
037C  22 F8 C3                  SHLD    V_OFFS
037F  CD 66 02                  CALL    RELOC
0382  E1                        POP     H
0383  7E                        MOV     A,M
0384  EF                        RST     5
0385  D7                        RST     2               ; ввод вставляемого байта
0386  77                        MOV     M,A
0387  C7                        RST     0
                    
                    ;------------------------------------------------------------------------------
                    ; 0388H: удаление байта (ввод: адрес удаляемого байта, конец программы).
                    ; Блок сдвигается на 1 вниз, адреса корректируются, затем просмотр памяти.
                    ;------------------------------------------------------------------------------
0388  F7            DELBYTE:    RST     6
0389  EB                        XCHG
038A  22 F0 C3                  SHLD    V_START
038D  22 F4 C3                  SHLD    V_NSTART
0390  4D                        MOV     C,L
0391  44                        MOV     B,H
0392  E5                        PUSH    H
0393  F7                        RST     6
0394  6B                        MOV     L,E
0395  62                        MOV     H,D
0396  22 F2 C3                  SHLD    V_END
0399  E1                        POP     H
039A  C5                        PUSH    B
039B  03                        INX     B
039C  CD 19 02                  CALL    COPYUP          ; сдвиг блока вниз на 1
039F  AF                        XRA     A
03A0  77                        MOV     M,A
03A1  2B                        DCX     H
03A2  22 F6 C3                  SHLD    V_NEND
03A5  21 FF FF                  LXI     H,0FFFFH        ; смещение -1
03A8  22 F8 C3                  SHLD    V_OFFS
03AB  CD 66 02                  CALL    RELOC
03AE  E1                        POP     H
03AF  C3 7D 00                  JMP     VIEW
                    
                    ;------------------------------------------------------------------------------
                    ; 03B2H: сравнение блоков (ввод: начало 1, конец 1, начало 2).
                    ; При несовпадении показывает адрес и байт блока 2, ждёт ввода нового
                    ; значения. По окончании - "1111 11" на индикаторе.
                    ;------------------------------------------------------------------------------
03B2  F7            COMPARE:    RST     6
03B3  4B                        MOV     C,E
03B4  42                        MOV     B,D             ; BC = начало 1
03B5  F7                        RST     6
03B6  D5                        PUSH    D               ; конец 1
03B7  F7                        RST     6
03B8  EB                        XCHG                    ; HL = начало 2
03B9  D1                        POP     D
03BA  0A            CMPL:       LDAX    B
03BB  BE                        CMP     M
03BC  C2 D4 03                  JNZ     CMPDIF
03BF  79                        MOV     A,C
03C0  BB                        CMP     E
03C1  C2 CF 03                  JNZ     CMPNXT
03C4  78                        MOV     A,B
03C5  BA                        CMP     D
03C6  C2 CF 03                  JNZ     CMPNXT
03C9  3E 11                     MVI     A,11H
03CB  6F                        MOV     L,A
03CC  67                        MOV     H,A
03CD  EF                        RST     5
03CE  C7                        RST     0
03CF  03            CMPNXT:     INX     B
03D0  23                        INX     H
03D1  C3 BA 03                  JMP     CMPL
03D4  F5            CMPDIF:     PUSH    PSW
03D5  7E                        MOV     A,M
03D6  EF                        RST     5
03D7  D7                        RST     2
03D8  77                        MOV     M,A
03D9  F1                        POP     PSW
03DA  C3 BA 03                  JMP     CMPL
                    
                    ;------------------------------------------------------------------------------
                    ; 03DDH: индикация регистров (вызывается из программы CALL 03DDH).
                    ; Последовательно по нажатию клавиши: HL и (HL); "AF" и A,F;
                    ; "BC" и BC; "DE" и DE. Все регистры сохраняются.
                    ;------------------------------------------------------------------------------
03DD  C5            REGS:       PUSH    B
03DE  D5                        PUSH    D
03DF  E5                        PUSH    H
03E0  F5                        PUSH    PSW
03E1  7E                        MOV     A,M
03E2  EF                        RST     5               ; HL, (HL)
03E3  E7                        RST     4
03E4  E3                        XTHL                    ; HL = PSW
03E5  3E AF                     MVI     A,0AFH
03E7  EF                        RST     5               ; A,F  "AF"
03E8  E7                        RST     4
03E9  E3                        XTHL
03EA  69                        MOV     L,C
03EB  60                        MOV     H,B
03EC  3E BC                     MVI     A,0BCH
03EE  EF                        RST     5               ; BC   "BC"
03EF  E7                        RST     4
03F0  EB                        XCHG
03F1  3E DE                     MVI     A,0DEH
03F3  EF                        RST     5               ; DE   "DE"
03F4  E7                        RST     4
03F5  F1                        POP     PSW
03F6  E1                        POP     H
03F7  D1                        POP     D
03F8  C1                        POP     B
03F9  C9                        RET
                    
03FA  FF FF FF FF               DB      0FFH,0FFH,0FFH,0FFH,0FFH,0FFH
03FE  FF FF
                    
                                END
